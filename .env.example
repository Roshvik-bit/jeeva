# ==========================================
# JEEVA Environment Variables & API Keys
# ==========================================
# In Vite, all environment variables accessible to the browser
# MUST start with the "VITE_" prefix.

# 1. AI Vision & Multimodal API (e.g., Google Gemini API)
# Used in: src/services/mockAiClassifier.js
VITE_GEMINI_API_KEY=your_gemini_api_key_here

# 2. Map & Geocoding Service (Optional - e.g., Mapbox / LocationIQ / Google Maps)
# Used in: src/services/geoService.js and IncidentMapView.jsx
VITE_MAPBOX_ACCESS_TOKEN=your_mapbox_token_here

# 3. Backend Cloud Sync Endpoint (Optional for production cloud DB)
# Used in: src/services/storageService.js
VITE_API_BASE_URL=https://api.jeeva-rescue.org/v1
